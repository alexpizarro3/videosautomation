# 🔐 CONFIGURACIÓN DE EJEMPLO PARA AUTOMATIZACIÓN TIKTOK
# ⚠️  Copiar este archivo a .env y completar con tus datos reales

# ===============================================
# 🤖 API KEYS REQUERIDAS
# ===============================================
# Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_EJEMPLO_DE_API_KEY_GEMINI
VEO3_API_KEY=AIzaSy_EJEMPLO_DE_API_KEY_VEO3

# Obtener en: https://developer.ideogram.ai/
# ⚡ FALLBACK para generación de imágenes cuando Gemini no está disponible
IDEOGRAM_API_KEY=ide_EJEMPLO_DE_API_KEY_IDEOGRAM

# ===============================================
# 📱 DATOS DE TUS CUENTAS
# ===============================================
# -- TikTok --
TIKTOK_USERNAME=tu_usuario_sin_arroba
TIKTOK_EMAIL=tu_email@gmail.com
TIKTOK_USE_COOKIES=true

# -- YouTube --
YOUTUBE_EMAIL=tu_email_de_youtube@gmail.com
YOUTUBE_PASSWORD=tu_contraseña_de_youtube

# ===============================================
# 📊 CONFIGURACIÓN DE ANÁLISIS
# ===============================================
TREND_ANALYSIS_ENABLED=true
MIN_TREND_SCORE=0.7
MAX_VIDEOS_PER_DAY=3

# ===============================================
# 🎨 GENERACIÓN DE CONTENIDO
# ===============================================
IMAGE_RESOLUTION=1080x1920
VIDEO_DURATION_SECONDS=15
VIDEO_FPS=30

# ===============================================
# 📁 RUTAS DE ARCHIVOS
# ===============================================
DATA_DIR=data
COOKIES_FILE=data/tiktok_cookies.json

# ===============================================
# 📝 SISTEMA DE LOGS
# ===============================================
LOG_LEVEL=INFO
LOG_FILE=logs/automation.log

# ===============================================
# ⏰ HORARIOS DE AUTOMATIZACIÓN
# ===============================================
CRON_ENABLED=true
CRON_SCHEDULE="0 9,15,21 * * *"  # 3 veces al día

# ===============================================
# 🧠 MODELOS DE IA
# ===============================================
GEMINI_MODEL=gemini-2.0-flash-exp
VEO3_MODEL=veo-3

# ===============================================
# 🎯 SISTEMA DE FALLBACK IDEOGRAM
# ===============================================
# Configuración para fallback de generación de imágenes
IDEOGRAM_STYLE_TYPE=REALISTIC
IDEOGRAM_RENDERING_SPEED=TURBO
IDEOGRAM_RESOLUTION=1024x1024
